// Resources linked into file-explorer-pro.exe. The icon is generated by make_icon.py.
1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "File Explorer Pro"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "file-explorer-pro"
      VALUE "OriginalFilename", "file-explorer-pro.exe"
      VALUE "ProductName", "File Explorer Pro"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
